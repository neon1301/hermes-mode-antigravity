{
  "hermes-context-injector": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ./hooks/context-injector.mjs",
        "timeout": 5
      }
    ]
  },
  "hermes-clean-edits": {
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/clean-edits-guard.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "hermes-qa-gate": {
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/qa-gate.mjs",
        "timeout": 10
      }
    ]
  }
}
