{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MutationReport",
  "type": "object",
  "required": ["diffHash", "timestamp"],
  "properties": {
    "status": { "type": "string", "enum": ["PASS", "REJECT", "unavailable", "advisory"] },
    "mutantsTotal": { "type": "integer", "minimum": 0 },
    "killed": { "type": "integer", "minimum": 0 },
    "survived": { "type": "integer", "minimum": 0 },
    "escaped": {
      "type": "array",
      "items": { "type": "string" }
    },
    "killRate": { "type": "number", "minimum": 0, "maximum": 1 },
    "threshold": { "type": "number", "minimum": 0, "maximum": 1 },
    "tool": { "type": "string" },
    "diffHash": { "type": "string" },
    "timestamp": { "type": "string" },
    "reason": { "type": "string" }
  }
}
