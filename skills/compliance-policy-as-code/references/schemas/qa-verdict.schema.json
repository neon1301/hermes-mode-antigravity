{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QAVerdict",
  "type": "object",
  "required": ["status", "agent", "reqsVerified", "timestamp"],
  "properties": {
    "status": { "type": "string", "enum": ["PASS", "REJECT"] },
    "agent": { "type": "string" },
    "reqsVerified": {
      "type": "array",
      "items": { "type": "string" }
    },
    "reason": { "type": "string" },
    "timestamp": { "type": "string" }
  }
}
